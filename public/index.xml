&lt;script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"&gt;&lt;/script&gt;
&lt;script&gt;
function renderSharpeChart() {
 var dataElement = document.getElementById('sharpeData');
 var chartElement = document.getElementById('sharpeChart');
 if (!dataElement || !chartElement || !window.echarts) return;

 var assets = JSON.parse(dataElement.textContent);

 var chart = echarts.init(chartElement);

 var symbols = assets.map(a =&gt; a.symbol);
 var sharpe = assets.map(a =&gt; a.excess_sharpe);
 var colors = sharpe.map(v =&gt; v &gt; 2 ? '#7c3aed' : (v &gt; 1 ? '#2563eb' : (v &lt; 0 ? '#dc2626' : '#f59e0b')));

 var option = {
 title: { text: 'Excess Sharpe by Asset', left: 'center' },
 tooltip: { trigger: 'axis' },
 xAxis: {
 type: 'category',
 data: symbols,
 axisLabel: { rotate: 45 }
 },
 yAxis: { type: 'value', name: 'Excess Sharpe' },
 series: [{
 type: 'bar',
 data: sharpe.map((v, i) =&gt; ({ value: v, itemStyle: { color: colors[i] } })),
 barWidth: '50%'
 }]
 };
 chart.setOption(option);
 window.addEventListener('resize', function() { chart.resize(); });
}

if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', renderSharpeChart);
} else {
 renderSharpeChart();
}
&lt;/script&gt;
