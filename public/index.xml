      <title>Papers &amp; insights</title>
      <link>http://localhost:1313/signal-blog/papers/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/signal-blog/papers/</guid>
      <description>&lt;h2 id=&#34;performance-explorer&#34;&gt;&#xA;  Performance explorer&#xA;  &lt;a class=&#34;heading-link&#34; href=&#34;#performance-explorer&#34;&gt;&#xA;    &lt;i class=&#34;fa-solid fa-link&#34; aria-hidden=&#34;true&#34; title=&#34;Link to heading&#34;&gt;&lt;/i&gt;&#xA;    &lt;span class=&#34;sr-only&#34;&gt;Link to heading&lt;/span&gt;&#xA;  &lt;/a&gt;&#xA;&lt;/h2&gt;&#xA;&lt;p&gt;The explorer compares the current asset-level results using the metrics available in the research dataset. Hover a chart mark for detail, or search and sort the table to inspect individual assets.&lt;/p&gt;&#xA;&#xA;&#xA;&#xA;&lt;section class=&#34;performance-explorer&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af&#34; aria-labelledby=&#34;performance-explorer-548fd7979b40e996391efd02580690af-title&#34;&gt;&#xA;  &lt;div class=&#34;explorer-heading&#34;&gt;&#xA;    &lt;div&gt;&#xA;      &lt;p class=&#34;module-code&#34;&gt;INTERACTIVE / PERFORMANCE&lt;/p&gt;&#xA;      &lt;h2 id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-title&#34;&gt;Cross-asset performance explorer&lt;/h2&gt;&#xA;      &lt;p&gt;Hover the charts for detail. Sort, filter, and inspect the complete asset-level results below.&lt;/p&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;span class=&#34;explorer-count&#34;&gt;17 assets&lt;/span&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;explorer-charts&#34;&gt;&#xA;    &lt;div class=&#34;explorer-chart-card&#34;&gt;&#xA;      &lt;div class=&#34;explorer-card-heading&#34;&gt;&lt;h3&gt;Sharpe and EV by asset&lt;/h3&gt;&lt;span&gt;comparison&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;explorer-chart&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-comparison&#34; role=&#34;img&#34; aria-label=&#34;Comparison chart of Sharpe and expected value by asset&#34;&gt;&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;div class=&#34;explorer-chart-card&#34;&gt;&#xA;      &lt;div class=&#34;explorer-card-heading&#34;&gt;&lt;h3&gt;Risk / return map&lt;/h3&gt;&lt;span&gt;drawdown vs Sharpe&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;explorer-chart&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-risk&#34; role=&#34;img&#34; aria-label=&#34;Scatter chart of maximum drawdown and Sharpe by asset&#34;&gt;&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;div class=&#34;explorer-table-shell&#34;&gt;&#xA;    &lt;div class=&#34;explorer-table-heading&#34;&gt;&lt;h3&gt;Asset-level detail&lt;/h3&gt;&lt;span&gt;Sortable / filterable&lt;/span&gt;&lt;/div&gt;&#xA;    &lt;label class=&#34;explorer-search&#34;&gt;Search assets &lt;input type=&#34;search&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-search&#34; placeholder=&#34;e.g. NVDA&#34;&gt;&lt;/label&gt;&#xA;    &lt;div class=&#34;performance-table&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-table&#34; aria-label=&#34;Detailed asset performance table&#34;&gt;&lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&#xA;  &lt;script type=&#34;application/json&#34; id=&#34;performance-explorer-548fd7979b40e996391efd02580690af-data&#34;&gt;&#34;[{\&#34;ev\&#34;:0.293,\&#34;excess_sharpe\&#34;:3.58,\&#34;max_drawdown\&#34;:\&#34;-25.7%\&#34;,\&#34;symbol\&#34;:\&#34;TSLA\&#34;,\&#34;verdict\&#34;:\&#34;exceptional\&#34;},{\&#34;ev\&#34;:0.26,\&#34;excess_sharpe\&#34;:3.17,\&#34;max_drawdown\&#34;:\&#34;-34.6%\&#34;,\&#34;symbol\&#34;:\&#34;BABA\&#34;,\&#34;verdict\&#34;:\&#34;exceptional\&#34;},{\&#34;ev\&#34;:0.264,\&#34;excess_sharpe\&#34;:3.05,\&#34;max_drawdown\&#34;:\&#34;-28.9%\&#34;,\&#34;symbol\&#34;:\&#34;META\&#34;,\&#34;verdict\&#34;:\&#34;exceptional\&#34;},{\&#34;ev\&#34;:0.18,\&#34;excess_sharpe\&#34;:2.67,\&#34;max_drawdown\&#34;:\&#34;-21.7%\&#34;,\&#34;symbol\&#34;:\&#34;NFLX\&#34;,\&#34;verdict\&#34;:\&#34;exceptional\&#34;},{\&#34;ev\&#34;:0.208,\&#34;excess_sharpe\&#34;:2.65,\&#34;max_drawdown\&#34;:\&#34;-29.0%\&#34;,\&#34;symbol\&#34;:\&#34;BIDU\&#34;,\&#34;verdict\&#34;:\&#34;exceptional\&#34;},{\&#34;ev\&#34;:0.132,\&#34;excess_sharpe\&#34;:2.47,\&#34;max_drawdown\&#34;:\&#34;-30.6%\&#34;,\&#34;symbol\&#34;:\&#34;FUTU\&#34;,\&#34;verdict\&#34;:\&#34;excellent\&#34;},{\&#34;ev\&#34;:0.182,\&#34;excess_sharpe\&#34;:2.15,\&#34;max_drawdown\&#34;:\&#34;-25.6%\&#34;,\&#34;symbol\&#34;:\&#34;GOOGL\&#34;,\&#34;verdict\&#34;:\&#34;excellent\&#34;},{\&#34;ev\&#34;:0.274,\&#34;excess_sharpe\&#34;:2.1,\&#34;max_drawdown\&#34;:\&#34;-30.1%\&#34;,\&#34;symbol\&#34;:\&#34;BLTE\&#34;,\&#34;verdict\&#34;:\&#34;excellent\&#34;},{\&#34;ev\&#34;:0.135,\&#34;excess_sharpe\&#34;:2.09,\&#34;max_drawdown\&#34;:\&#34;-39.9%\&#34;,\&#34;symbol\&#34;:\&#34;ARM\&#34;,\&#34;verdict\&#34;:\&#34;excellent\&#34;},{\&#34;ev\&#34;:0.168,\&#34;excess_sharpe\&#34;:2.2,\&#34;max_drawdown\&#34;:\&#34;-48.4%\&#34;,\&#34;symbol\&#34;:\&#34;AMD\&#34;,\&#34;verdict\&#34;:\&#34;excellent\&#34;},{\&#34;ev\&#34;:0.173,\&#34;excess_sharpe\&#34;:1.87,\&#34;max_drawdown\&#34;:\&#34;-36.4%\&#34;,\&#34;symbol\&#34;:\&#34;COIN\&#34;,\&#34;verdict\&#34;:\&#34;good\&#34;},{\&#34;ev\&#34;:0.121,\&#34;excess_sharpe\&#34;:1.44,\&#34;max_drawdown\&#34;:\&#34;-23.9%\&#34;,\&#34;symbol\&#34;:\&#34;AAPL\&#34;,\&#34;verdict\&#34;:\&#34;good\&#34;},{\&#34;ev\&#34;:0.113,\&#34;excess_sharpe\&#34;:1.49,\&#34;max_drawdown\&#34;:\&#34;-45.3%\&#34;,\&#34;symbol\&#34;:\&#34;MSTR\&#34;,\&#34;verdict\&#34;:\&#34;marginal\&#34;},{\&#34;ev\&#34;:0.114,\&#34;excess_sharpe\&#34;:1.3,\&#34;max_drawdown\&#34;:\&#34;-48.6%\&#34;,\&#34;symbol\&#34;:\&#34;NVDA\&#34;,\&#34;verdict\&#34;:\&#34;good\&#34;},{\&#34;ev\&#34;:0.121,\&#34;excess_sharpe\&#34;:1.3,\&#34;max_drawdown\&#34;:\&#34;-28.8%\&#34;,\&#34;symbol\&#34;:\&#34;QCOM\&#34;,\&#34;verdict\&#34;:\&#34;good\&#34;},{\&#34;ev\&#34;:0.064,\&#34;excess_sharpe\&#34;:0.78,\&#34;max_drawdown\&#34;:\&#34;-23.3%\&#34;,\&#34;symbol\&#34;:\&#34;MSFT\&#34;,\&#34;verdict\&#34;:\&#34;marginal\&#34;},{\&#34;ev\&#34;:-0.022,\&#34;excess_sharpe\&#34;:0.65,\&#34;max_drawdown\&#34;:\&#34;-34.7%\&#34;,\&#34;symbol\&#34;:\&#34;TSM\&#34;,\&#34;verdict\&#34;:\&#34;reject\&#34;}]&#34;&lt;/script&gt;&#xA;  &lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdn.jsdelivr.net/npm/tabulator-tables@5/dist/css/tabulator.min.css&#34;&gt;&#xA;  &lt;script src=&#34;https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js&#34;&gt;&lt;/script&gt;&#xA;  &lt;script src=&#34;https://cdn.jsdelivr.net/npm/tabulator-tables@5/dist/js/tabulator.min.js&#34;&gt;&lt;/script&gt;&#xA;  &lt;script&gt;&#xA;  (function() {&#xA;    var root = document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af&#34;);&#xA;    var dataElement = document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af-data&#34; | jsonify | safeJS);&#xA;    if (!root || !dataElement || !window.echarts || !window.Tabulator) return;&#xA;&#xA;    var assets = JSON.parse(dataElement.textContent).map(function(asset) {&#xA;      return Object.assign({}, asset, { drawdownValue: parseFloat(asset.max_drawdown) });&#xA;    });&#xA;    var colors = { exceptional: &#39;#00f5d4&#39;, excellent: &#39;#7d72ff&#39;, good: &#39;#6fd3a8&#39;, marginal: &#39;#f4c95d&#39;, reject: &#39;#ff6b6b&#39; };&#xA;    var textColor = &#39;#8998a9&#39;;&#xA;    var lineColor = &#39;#1d3041&#39;;&#xA;&#xA;    function tooltip(params) {&#xA;      var item = params[0] &amp;&amp; params[0].data &amp;&amp; params[0].data.asset;&#xA;      var asset = assets.find(function(row) { return row.symbol === item; });&#xA;      if (!asset) return &#39;&#39;;&#xA;      return &#39;&lt;strong&gt;&#39; + asset.symbol + &#39;&lt;/strong&gt;&lt;br&gt;&#39; +&#xA;        &#39;Excess Sharpe: &#39; + Number(asset.excess_sharpe).toFixed(2) + &#39;&lt;br&gt;&#39; +&#xA;        &#39;EV / trade: &#39; + Number(asset.ev).toFixed(3) + &#39;&lt;br&gt;&#39; +&#xA;        &#39;Max drawdown: &#39; + asset.max_drawdown + &#39;&lt;br&gt;&#39; +&#xA;        &#39;Verdict: &#39; + asset.verdict;&#xA;    }&#xA;&#xA;    var comparison = echarts.init(document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af-comparison&#34; | jsonify | safeJS ));&#xA;    comparison.setOption({&#xA;      backgroundColor: &#39;transparent&#39;,&#xA;      color: [&#39;#00f5d4&#39;, &#39;#7d72ff&#39;],&#xA;      grid: { left: 48, right: 18, top: 35, bottom: 60 },&#xA;      legend: { textStyle: { color: textColor, fontSize: 11 }, top: 0 },&#xA;      tooltip: { trigger: &#39;axis&#39;, formatter: tooltip },&#xA;      xAxis: { type: &#39;category&#39;, data: assets.map(function(row) { return row.symbol; }), axisLabel: { color: textColor, rotate: 45, fontSize: 10 }, axisLine: { lineStyle: { color: lineColor } } },&#xA;      yAxis: { type: &#39;value&#39;, axisLabel: { color: textColor, fontSize: 10 }, splitLine: { lineStyle: { color: lineColor } } },&#xA;      series: [&#xA;        { name: &#39;Excess Sharpe&#39;, type: &#39;bar&#39;, barMaxWidth: 18, data: assets.map(function(row) { return { value: row.excess_sharpe, asset: row.symbol, itemStyle: { color: colors[row.verdict] || &#39;#00f5d4&#39; } }; }) },&#xA;        { name: &#39;EV / trade&#39;, type: &#39;line&#39;, smooth: true, data: assets.map(function(row) { return { value: row.ev, asset: row.symbol }; }) }&#xA;      ]&#xA;    });&#xA;&#xA;    var risk = echarts.init(document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af-risk&#34; | jsonify | safeJS ));&#xA;    risk.setOption({&#xA;      backgroundColor: &#39;transparent&#39;,&#xA;      grid: { left: 55, right: 18, top: 25, bottom: 45 },&#xA;      tooltip: { trigger: &#39;item&#39;, formatter: function(params) { return tooltip([{ data: { asset: params.data.asset } }]); } },&#xA;      xAxis: { type: &#39;value&#39;, name: &#39;Max drawdown %&#39;, nameTextStyle: { color: textColor }, axisLabel: { color: textColor, fontSize: 10 }, splitLine: { lineStyle: { color: lineColor } } },&#xA;      yAxis: { type: &#39;value&#39;, name: &#39;Excess Sharpe&#39;, nameTextStyle: { color: textColor }, axisLabel: { color: textColor, fontSize: 10 }, splitLine: { lineStyle: { color: lineColor } } },&#xA;      series: [{ type: &#39;scatter&#39;, symbolSize: 13, data: assets.map(function(row) { return { value: [row.drawdownValue, row.excess_sharpe], asset: row.symbol, itemStyle: { color: colors[row.verdict] || &#39;#00f5d4&#39; } }; }) }]&#xA;    });&#xA;&#xA;    var table = new Tabulator(document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af-table&#34; | jsonify | safeJS), {&#xA;      data: assets,&#xA;      layout: &#39;fitColumns&#39;,&#xA;      responsiveLayout: &#39;collapse&#39;,&#xA;      pagination: true,&#xA;      paginationSize: 10,&#xA;      paginationSizeSelector: [10, 20],&#xA;      placeholder: &#39;No matching assets&#39;,&#xA;      columns: [&#xA;        { title: &#39;Asset&#39;, field: &#39;symbol&#39;, sorter: &#39;string&#39;, width: 100 },&#xA;        { title: &#39;Excess Sharpe&#39;, field: &#39;excess_sharpe&#39;, sorter: &#39;number&#39;, formatter: function(cell) { return Number(cell.getValue()).toFixed(2); } },&#xA;        { title: &#39;Max drawdown&#39;, field: &#39;max_drawdown&#39;, sorter: &#39;number&#39; },&#xA;        { title: &#39;EV / trade&#39;, field: &#39;ev&#39;, sorter: &#39;number&#39;, formatter: function(cell) { return Number(cell.getValue()).toFixed(3); } },&#xA;        { title: &#39;Verdict&#39;, field: &#39;verdict&#39;, sorter: &#39;string&#39;, formatter: function(cell) { var value = cell.getValue(); return &#39;&lt;span class=&#34;performance-verdict performance-verdict-&#39; + value + &#39;&#34;&gt;&#39; + value + &#39;&lt;/span&gt;&#39;; } }&#xA;      ]&#xA;    });&#xA;&#xA;    var search = document.getElementById(&#34;performance-explorer-548fd7979b40e996391efd02580690af-search&#34; | jsonify | safeJS);&#xA;    search.addEventListener(&#39;input&#39;, function(event) { table.setFilter(&#39;symbol&#39;, &#39;like&#39;, event.target.value); });&#xA;    window.addEventListener(&#39;resize&#39;, function() { comparison.resize(); risk.resize(); });&#xA;  }());&#xA;  &lt;/script&gt;&#xA;&lt;/section&gt;&#xA;&#xA;&lt;h2 id=&#34;live-trading-insights&#34;&gt;&#xA;  Live trading insights&#xA;  &lt;a class=&#34;heading-link&#34; href=&#34;#live-trading-insights&#34;&gt;&#xA;    &lt;i class=&#34;fa-solid fa-link&#34; aria-hidden=&#34;true&#34; title=&#34;Link to heading&#34;&gt;&lt;/i&gt;&#xA;    &lt;span class=&#34;sr-only&#34;&gt;Link to heading&lt;/span&gt;&#xA;  &lt;/a&gt;&#xA;&lt;/h2&gt;&#xA;&lt;p&gt;The public research layer documents methods and findings. The core algorithm remains private; derived analytical modules can be developed independently around risk, performance, allocation, and behaviour.&lt;/p&gt;</description>
    </item>
